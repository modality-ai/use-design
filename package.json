  "license": "ISC",
  "git.addAICoAuthor": "off",
  "dependencies": {
    "modality-cli-kit": "*",
    "modality-mcp-kit": "*",
    "zod": "*",
    "hono": "*",
    "yaml": "^2.8.3",
    "@tailwindcss/cli": "^4.2.2",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@modality-counter/core": "*",
    "modality-bun-kit": "*",
    "react": "*",
    "react-dom": "*"
  },
  "exports": {
    "types": "./types/index.d.ts",
    "require": "./dist/index.js",
    "import": "./dist/index.js"
  },
  "types": "./types/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "bin": {
    "use-design": "./dist/runner/cli.js"
  },
  "scripts": {
    "clean": "find ./dist -name '*.*' | xargs rm -rf",
    "build:types": "bun tsc -p ./",
    "build:commands": "modality-cli generate-commands",
    "build:cli": "bun build ./src/runner/cli.ts ./src/index.ts --target=bun --outdir=./dist --root=./src --external @modality-counter/core",
    "build": "bun run build:commands && bun run clean && bun run build:types && bun run build:cli && chmod +x ./dist/runner/cli.js",
    "test": "bun run build:commands && npm run build && bun test",
    "build:web": "bun run src/runner/cli.ts build",
    "start": "bun --hot src/runner/server.ts",
    "dev": "bun run src/runner/cli.ts build && bun --hot src/runner/server.ts"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ]
}
